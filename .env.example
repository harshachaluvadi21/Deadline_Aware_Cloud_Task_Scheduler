# ==========================================
# Frontend Configuration (Vite)
# ==========================================
# Google Gemini API Key for Cloud Task Scheduler AI Analyst
# Get a free API key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Backend API Base URL (defaults to http://localhost:8080 if omitted)
VITE_API_BASE_URL=http://localhost:8080

# ==========================================
# Backend Configuration (Spring Boot)
# ==========================================
# Server port (default: 8080)
PORT=8080

# Real Execution Cloud Worker URL (default: http://127.0.0.1:5000)
CLOUD_WORKER_URL=http://127.0.0.1:5000
